# Copy to `.env` and fill in. Only PUBLIC values belong here:
# anything prefixed EXPO_PUBLIC_ is inlined into the app bundle.

# Supabase (phase 3) — the anon key is public by design; RLS protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Play Store listing (used in share cards, phase 4)
EXPO_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.su2al.app
